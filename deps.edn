{:paths ["src" "resources" "target/resources"]
 :deps  {org.clojure/clojure             {:mvn/version "1.12.6"}
         com.biffweb/defaults            {:mvn/version "2.0.2"}
         dev.onionpancakes/chassis       {:mvn/version "1.0.365"}
         cheshire/cheshire               {:mvn/version "6.2.0"}
         org.clojure/data.csv            {:mvn/version "1.1.0"}
         hato/hato                       {:mvn/version "1.0.0"}
         io.minio/minio                  {:mvn/version "8.6.0"}
         com.squareup.okhttp3/okhttp-jvm {:mvn/version "5.1.0"}
         nrepl/nrepl                     {:mvn/version "1.7.0"}
         cider/cider-nrepl               {:mvn/version "0.62.2"}
         tick/tick                       {:mvn/version "1.0.1"}
         org.clojure/tools.logging       {:mvn/version "1.3.1"}
         org.slf4j/slf4j-simple          {:mvn/version "2.0.19"}
         remus/remus                     {:mvn/version "0.2.6"}}

 :aliases
 {:prod {:jvm-opts  ["-Djdk.attach.allowAttachSelf"
                     "-XX:-OmitStackTraceInFastThrow"
                     "-XX:+CrashOnOutOfMemoryError"]
         :main-opts ["-m" "com.platypub"]}
  :run  {:extra-paths ["dev" "test"]
         :extra-deps  {com.biffweb/tasks {:mvn/version "2.0.2"}}
         :main-opts   ["-m" "tasks"]}}}
