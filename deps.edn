{:paths ["src" "resources" "target/resources"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.6"}
         com.biffweb/defaults      {:mvn/version "2.0.0-rc26"}
         dev.onionpancakes/chassis {:mvn/version "1.0.365"}
         cheshire/cheshire         {:mvn/version "6.2.0"}
         hato/hato                 {:mvn/version "1.0.0"}
         nrepl/nrepl               {:mvn/version "1.7.0"}
         cider/cider-nrepl         {:mvn/version "0.62.2"}
         org.clojure/tools.logging {:mvn/version "1.3.1"}
         org.slf4j/slf4j-simple    {:mvn/version "2.0.19"}}

 :aliases
 {:prod {:jvm-opts  ["-Djdk.attach.allowAttachSelf"
                     "-XX:-OmitStackTraceInFastThrow"
                     "-XX:+CrashOnOutOfMemoryError"]
         :main-opts ["-m" "com.platypub"]}
  :run  {:extra-paths ["test"]
         :extra-deps  {com.biffweb/tasks {:mvn/version "2.0.0-rc26"}}
         :main-opts   ["-m" "com.biffweb.tasks.app"]}}}
