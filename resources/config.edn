#merge
 [{:biff.admin/admin-user-id #biff/env ADMIN_USER_ID,
   :biff.admin/alert-email   #biff/env ALERT_EMAIL,

   :biff.auth/skip-captcha
   #boolean #or [#biff/env SKIP_CAPTCHA "false"],

   :biff.auth/turnstile-secret   #biff/secret TURNSTILE_SECRET_KEY,
   :biff.auth/turnstile-site-key #biff/env TURNSTILE_SITE_KEY,

   :biff.config/system-properties
   {"clojure.main.report"                          "stderr",
    "org.slf4j.simpleLogger.log.com.zaxxer.hikari" "error",
    "org.slf4j.simpleLogger.log.org.eclipse.jetty" "error"},

   :biff.ring/cookie-secret #biff/secret COOKIE_SECRET,
   :biff.ring/host          #or [#biff/env HOST "localhost"],
   :biff.ring/port          #long #or [#biff/env PORT "8080"],
   :biff.ring/secure        #boolean #or [#biff/env SECURE "true"],

   :biff.sqlite/db-path                  #or [#biff/env SQLITE_DB_PATH
                                              "storage/sqlite/main.db"],
   :biff.sqlite/litestream-access-key-id #biff/env LITESTREAM_ACCESS_KEY_ID,
   :biff.sqlite/litestream-bucket        #biff/env LITESTREAM_BUCKET,
   :biff.sqlite/litestream-endpoint      #biff/env LITESTREAM_ENDPOINT,
   :biff.sqlite/litestream-region        #biff/env LITESTREAM_REGION,
   :biff.sqlite/litestream-replica-path  #biff/env LITESTREAM_REPLICA_PATH

   :biff.sqlite/litestream-secret-access-key
   #biff/secret LITESTREAM_SECRET_ACCESS_KEY,

   :biff.tasks/css-input-path       "resources/tailwind.css",

   :biff.tasks/css-output-path
   "target/resources/public/css/main.css",

   :biff.tasks/deploy-untracked-files
   [#ref [:form 0 :biff.tasks/css-output-path]
    {:dest "config.env", :src "config.prod.env"}],

   :biff.tasks/deployment-name #or [#biff/env DEPLOYMENT_NAME "platypub"],
   :biff.tasks/domain          #biff/env DOMAIN,
   :biff.tasks/main-ns         com.platypub,
   :biff.tasks/nrepl-port      #long #or [#biff/env NREPL_PORT "7888"],

   :mailersend/api-key   #biff/secret MAILERSEND_API_KEY,
   :mailersend/base-url  #or [#biff/env MAILERSEND_BASE_URL
                              "https://api.mailersend.com"],
   :mailersend/from      #biff/env MAILERSEND_FROM,
   :mailersend/from-name "Platypub",
   :mailersend/plan      #keyword #or [#biff/env MAILERSEND_PLAN "free"]
   :mailersend/reply-to  #biff/env MAILERSEND_REPLY_TO,
   :mailersend/domain-id #biff/env MAILERSEND_DOMAIN_ID,

   :platypub/mock-mailersend-enabled
   #boolean #or [#biff/env MOCK_MAILERSEND "false"],

   :platypub/local-minio-enabled
   #boolean #or [#biff/env LOCAL_MINIO "false"],

   :platypub/local-minio-command #or [#biff/env MINIO_COMMAND "minio"],

   :platypub/local-minio-data-dir
   #or [#biff/env MINIO_DATA_DIR "storage/minio"],

   :platypub/local-minio-port        #long #or [#biff/env MINIO_PORT "9000"],
   :platypub.object-store/endpoint   #or [#biff/env OBJECT_STORE_ENDPOINT
                                          "http://localhost:9000"],
   :platypub.object-store/access-key #biff/secret OBJECT_STORE_ACCESS_KEY,
   :platypub.object-store/secret-key #biff/secret OBJECT_STORE_SECRET_KEY,

   :platypub.object-store/bucket
   #or [#biff/env OBJECT_STORE_BUCKET "platypub"],

   :platypub/cdn-url-template #biff/env CDN_URL_TEMPLATE,

   :platypub/hcaptcha-site-key   #biff/env HCAPTCHA_SITE_KEY,
   :platypub/hcaptcha-secret-key #biff/secret HCAPTCHA_SECRET_KEY,

   :platypub/base-url #or [#biff/env BASE_URL "http://localhost:8080"],

   :platypub/unsubscribe-secret #or [#biff/secret UNSUBSCRIBE_SECRET
                                     #biff/secret COOKIE_SECRET],

   :platypub/waitlist-enabled
   #boolean #or [#biff/env WAITLIST_ENABLED "false"]

   :biff.tasks/skip-project-files true}

  #profile
   {:dev  #include "config.dev.edn"
    :prod #include "config.prod.edn"}]
